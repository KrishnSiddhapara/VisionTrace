# VisionTrace AI Environment Configuration

# VLM Provider Settings (OpenAI / Gemini / Custom / Mock)
VLM_PROVIDER=gemini  # gemini | openai | custom | mock
VLM_API_KEY=
VLM_MODEL=gemini-2.5-flash
VLM_BASE_URL=

# Processing Limits & Defaults
MAX_VIDEO_SIZE_MB=200
MAX_VIDEO_DURATION_SEC=600
DEFAULT_SAMPLE_INTERVAL_SEC=5
MAX_VLM_FRAMES=100
YOLO_CONFIDENCE=0.40

# Feature Flags
ENABLE_TRACKING=True
ENABLE_ANOMALY_DETECTION=True
ENABLE_SEMANTIC_SEARCH=True
